{
  "name": "kamaji",
  "version": "0.2.0",
  "module": "index.tsx",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun run build.ts",
    "postbuild": "bun run relative-pathing",
    "build:watch": "bun run build.ts --watch",
    "dev": "bun run build && bun run --watch index.tsx",
    "start": "NODE_ENV=production bun run dist/index.js",
    "test": "bun test",
    "relative-pathing": "./node_modules/relative-pathing/bin/relative-pathing --in ./public/projects-showcase --out ./public/projects-showcase --rules ./relative-pathing.json",
    "changeset": "bunx changeset",
    "version": "bunx changeset version",
    "release": "bun run build && bunx changeset tag"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "hono": "^4.10.8",
    "hono-rate-limiter": "^0.5.3",
    "relative-pathing": "github:ed-yahska-xyz/relative-pathing#main"
  },
  "trustedDependencies": [
    "relative-pathing"
  ]
}
